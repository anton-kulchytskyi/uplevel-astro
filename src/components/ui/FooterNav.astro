---
export interface Props {
  title: string;
  links: Array<{
    title: string;
    url: string;
  }>;
}

const { title, links } = Astro.props;
---

<div class="footer-nav-column">
  <h3 class="footer-section-title">{title}</h3>
  <ul class="footer-nav-list">
    {
      links.map((link) => (
        <li>
          <a href={link.url} class="footer-link text-link">
            {link.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .footer-nav-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-section-title {
    color: rgba(255, 255, 255, 0.95);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.05em;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Hover treatment comes from the shared .text-link class in BaseLayout. */
  .footer-link {
    font-size: 0.95rem;
  }
</style>
